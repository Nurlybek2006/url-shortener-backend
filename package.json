{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma7.config.ts",
    "prisma:studio": "prisma studio --config prisma7.config.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "test:integration": "jest --runInBand tests/postgres.integration.test.js tests/redis.integration.test.js",
    "prisma:deploy": "prisma migrate deploy --config prisma7.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "URL Shortener and Analytics Backend",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0"
  },
  "devDependencies": {
