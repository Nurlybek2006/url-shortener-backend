# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# PostgreSQL for the API running on your host
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/url_shortener?schema=public"
# Optional dedicated test database; name must contain a delimited 'test'.
# Never point this at the development/production database.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/url_shortener_test?schema=public"
# Optional real Redis tests: unique test keys only; never flush the database.
# TEST_REDIS_URL=redis://localhost:6379/15
REDIS_URL=redis://localhost:6379

# Generate a random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production requires at least 32 characters. Do not commit real secrets.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated browser origins. Empty denies cross-origin access in production.
# Same-origin BASE_URL remains allowed; development also allows loopback origins.
CLIENT_URL=http://localhost:5173
# false, or trusted proxy IPs/subnets/names (comma-separated); never true.
TRUST_PROXY=false

# Docker Compose. Match credentials used when the EXISTING volume was initialized.
# Changing these does not change an existing PostgreSQL role's password.
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=url_shortener
# Used only by the optional api profile; percent-encode credentials in URLs.
DATABASE_URL_DOCKER="postgresql://USER:PASSWORD@postgres:5432/url_shortener?schema=public"
